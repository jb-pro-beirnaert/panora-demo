# Copy to .env at the repository root (single env file for the whole monorepo).

# --- Shared ---
# Enables the /admin/* routes (seed, reset) of the services. Demo only.
DEMO_MODE=true
# Bearer token required by /admin/* routes (16+ characters). Used by the simulator to seed.
ADMIN_TOKEN=change-me-local-admin-token

# --- Postgres (compose.yaml) ---
# Superuser credentials of the local Postgres container (tmpfs, no volume).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port Postgres is published on.
POSTGRES_PORT=5432

# --- MCP extranet server (apps/mcp-extranet) ---
# HTTP port of the MCP server (Streamable HTTP on /mcp, health on /health).
MCP_EXTRANET_PORT=3002
# Connection string of the `extranet` database (Prisma migrations run on startup).
EXTRANET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extranet
# Base URL of the MCP server, used by the simulator (seed) and the Mastra server (/mcp).
MCP_EXTRANET_URL=http://localhost:3002

# --- Simulator (apps/simulator) ---
# HTTP port of the demo simulator.
SIMULATOR_PORT=3003
# Seed of the generated world and e-mails: same seed, same data.
WORLD_SEED=42
# Number of e-mails generated (the first 9 cover every scenario of the catalog).
SIMULATOR_EMAIL_COUNT=10

# --- Mastra server (apps/agents) ---
# HTTP port of the Mastra server (and Mastra Studio in dev).
MASTRA_PORT=4111
# Connection string of the `agents` database (workflow snapshots; tables created on first use).
AGENTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents
# OpenAI API key, read by Mastra's model router for openai/* models (required for the defaults).
OPENAI_API_KEY=sk-your-key-here
# Models, as Mastra model ids (provider/model). Cheap defaults: light model for triage, small
# tool-capable model for coverage analysis. An anthropic/* model needs ANTHROPIC_API_KEY instead.
TRIAGE_MODEL=openai/gpt-5-nano
COVERAGE_MODEL=openai/gpt-6-luna
