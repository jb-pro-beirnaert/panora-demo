# Copy to .env at the repository root (single env file for the whole monorepo).

# --- Shared ---
# Enables the /admin/* routes (seed, reset) of the services. Demo only.
DEMO_MODE=true
# Bearer token required by /admin/* routes (16+ characters). Used by the simulator to seed.
ADMIN_TOKEN=change-me-local-admin-token

# --- Postgres (compose.yaml) ---
# Superuser credentials of the local Postgres container (tmpfs, no volume).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port Postgres is published on.
POSTGRES_PORT=5432

# --- Redis (compose.yaml) ---
# Host port Redis is published on (no persistence: queues start empty).
REDIS_PORT=6379

# --- Core API (apps/core-api) ---
# HTTP port of the Core API (REST + SSE on /realtime).
CORE_API_PORT=3001
# Connection string of the `core` database (Prisma migrations run on startup).
CORE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/core
# Redis of the BullMQ queues (process-email, resume-workflow).
REDIS_URL=redis://localhost:6379
# Base URL of the Core API, used by the Mastra server (callbacks, find_client) and the simulator.
CORE_API_URL=http://localhost:3001
# Bearer token (16+ characters) of the Mastra -> Core callbacks on /internal/*. Same value on both sides.
CORE_SERVICE_TOKEN=change-me-local-core-service-token
# Base URL of the Mastra server, used by the Core workers to start and resume workflows.
MASTRA_URL=http://localhost:4111
# Origin(s) of the web UI allowed by CORS on the Core API and the simulator (comma-separated).
WEB_ORIGIN=http://localhost:3000

# --- MCP extranet server (apps/mcp-extranet) ---
# HTTP port of the MCP server (Streamable HTTP on /mcp, health on /health).
MCP_EXTRANET_PORT=3002
# Connection string of the `extranet` database (Prisma migrations run on startup).
EXTRANET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extranet
# Base URL of the MCP server, used by the simulator (seed) and the Mastra server (/mcp).
MCP_EXTRANET_URL=http://localhost:3002
# Secret (32+ characters) signing the MCP tokens: the Mastra server issues a `read` and a `write`
# token per brokerage, the MCP server verifies them. Print one with
# `npm run token -w apps/mcp-extranet -- read DLM-075` (e.g. for the MCP inspector).
MCP_TOKEN_SECRET=change-me-local-mcp-token-secret-32-chars-min

# --- Simulator (apps/simulator) ---
# HTTP port of the demo simulator.
SIMULATOR_PORT=3003
# Seed of the generated world and e-mails: same seed, same data.
WORLD_SEED=42
# Size of the generated e-mail pool the stream goes through (the first 11 cover every scenario).
SIMULATOR_EMAIL_COUNT=40
# Default pace of the e-mail stream (adjustable from the demo panel).
SIMULATOR_EMAILS_PER_MINUTE=4
# Share of English-speaking clients in the world and of English e-mails in the stream (0 to 1).
SIMULATOR_ENGLISH_SHARE=0.3

# --- Mastra server (apps/agents) ---
# HTTP port of the Mastra server (and Mastra Studio in dev).
MASTRA_PORT=4111
# Connection string of the `agents` database (workflow snapshots; tables created on first use).
AGENTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents
# OpenAI API key, read by Mastra's model router for openai/* models (required for the defaults).
OPENAI_API_KEY=sk-your-key-here
# Models, as Mastra model ids (provider/model). Cheap defaults: light model for triage, small
# tool-capable model for coverage analysis and for drafting the client e-mail and internal note.
# An anthropic/* model needs ANTHROPIC_API_KEY instead.
TRIAGE_MODEL=openai/gpt-5-nano
COVERAGE_MODEL=openai/gpt-6-luna
DRAFTING_MODEL=openai/gpt-6-luna

# --- Tracing: Langfuse (Cloud in V5, self-hosted in V6) ---
# Project keys (Langfuse > Settings > API keys). Leave empty to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse URL: https://cloud.langfuse.com (or https://us.cloud.langfuse.com), or the self-hosted one.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Environment tag of the traces.
LANGFUSE_ENVIRONMENT=local
# Self-hosted Langfuse (`npm run dev:langfuse`, http://localhost:3100): use instead
#   LANGFUSE_BASE_URL=http://localhost:3100
#   LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
#   LANGFUSE_SECRET_KEY=sk-lf-local-demo
#   NEXT_PUBLIC_LANGFUSE_URL=http://localhost:3100
#   NEXT_PUBLIC_LANGFUSE_PROJECT_ID=panora-demo
# The project, these keys and a login (demo@panora-demo.local / demo-password) are created on startup.
# Optional overrides of the local instance (compose.yaml defaults shown):
LANGFUSE_PORT=3100
LANGFUSE_LOCAL_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_LOCAL_SECRET_KEY=sk-lf-local-demo
LANGFUSE_LOCAL_PROJECT_ID=panora-demo
LANGFUSE_LOCAL_USER_EMAIL=demo@panora-demo.local
LANGFUSE_LOCAL_USER_PASSWORD=demo-password

# --- Web (apps/web) ---
# URLs the browser uses to reach the Core API and the simulator (inlined at build time).
NEXT_PUBLIC_CORE_API_URL=http://localhost:3001
NEXT_PUBLIC_SIMULATOR_URL=http://localhost:3003
# Langfuse UI for the "View the trace" links (same host as LANGFUSE_BASE_URL). With the project id
# (visible in the Langfuse URL) the link opens the trace directly.
NEXT_PUBLIC_LANGFUSE_URL=https://cloud.langfuse.com
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=
