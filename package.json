{
  "name": "panora-demo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run infra:reset && turbo run dev",
    "infra:reset": "docker compose up -d --force-recreate --wait postgres",
    "infra:down": "docker compose --profile apps down --remove-orphans",
    "start:docker": "docker compose --profile apps up -d --build --force-recreate --wait",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.12",
    "typescript": "^6.0.3"
  }
}
