{
  "name": "panora-demo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "evals"
  ],
  "scripts": {
    "dev": "npm run infra:reset && turbo run dev",
    "infra:reset": "docker compose up -d --force-recreate --wait postgres redis",
    "infra:down": "docker compose --profile apps --profile langfuse down --remove-orphans",
    "start:docker": "docker compose --profile apps up -d --build --force-recreate --wait",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "turbo run test:integration",
    "infra:reset:langfuse": "docker compose --profile langfuse up -d --force-recreate --wait postgres redis langfuse-web langfuse-worker",
    "dev:langfuse": "npm run infra:reset:langfuse && turbo run dev",
    "gen:evals": "npm run gen -w evals --",
    "evals": "npm run run -w evals --"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.12",
    "typescript": "^6.0.3"
  }
}
