{
  "name": "@demo/mcp-extranet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "generate": "prisma generate",
    "token": "tsx --env-file-if-exists=../../.env src/scripts/issue-token.ts",
    "test": "tsx --test 'src/chaos/*.test.ts'",
    "test:integration": "prisma generate && tsx --test 'src/**/*.int.test.ts'"
  },
  "devDependencies": {
    "@demo/eslint-config": "^0.0.0",
    "@demo/tsconfig": "^0.0.0",
    "@types/express": "^5.0.6",
    "prisma": "^7.10.1",
    "@demo/world-generator": "^0.0.0",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.6"
  },
  "dependencies": {
    "@demo/shared": "^0.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
