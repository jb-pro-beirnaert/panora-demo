// Database of the simulated insurer extranets. Only the MCP extranet server reads or writes it.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PolicyStatus {
  active
  suspended
  terminated
}

model Insurer {
  id       String   @id
  name     String
  locale   String
  policies Policy[]
  clauses  Clause[]
}

model Policy {
  number                  String       @id
  insurerId               String
  insurer                 Insurer      @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  holderName              String
  /// Lower-case, accent-free holder name, for `search_policy`.
  holderNameSearch        String
  holderSiren             String
  brokerCode              String
  product                 String
  status                  PolicyStatus
  startDate               DateTime     @db.Date
  endDate                 DateTime?    @db.Date
  endReason               String?
  /// V15: next renewal date; a cancellation by the client takes effect on a renewal.
  renewalDate             DateTime     @db.Date
  /// V15: when the client's cancellation was recorded (the policy stays active until endDate).
  cancellationRequestedAt DateTime?    @db.Date
  coverages               Coverage[]
  claims                  Claim[]

  @@index([holderNameSearch])
  @@index([brokerCode])
}

model Coverage {
  id           Int      @id @default(autoincrement())
  policyNumber String
  policy       Policy   @relation(fields: [policyNumber], references: [number], onDelete: Cascade)
  peril        String
  label        String
  limit        Int
  deductible   Int
  exclusions   String[]
  clauseRef    String

  @@index([policyNumber])
}

model Clause {
  ref       String  @id
  insurerId String
  insurer   Insurer @relation(fields: [insurerId], references: [id], onDelete: Cascade)
  title     String
  text      String
  /// General clause of the policy (declaration delay, termination…) rather than a coverage clause.
  general   Boolean
}

model Claim {
  number       String   @id
  policyNumber String
  policy       Policy   @relation(fields: [policyNumber], references: [number], onDelete: Cascade)
  date         DateTime @db.Date
  nature       String
  amount       Int
  status       String
  description  String
  /// File names of the supporting documents sent with the declaration.
  documents    String[] @default([])
  /// Brokerage that filed the claim through `file_claim`; null for the seeded history.
  filedBy      String?
  createdAt    DateTime @default(now())

  @@index([policyNumber])
}

/// One row per MCP tool call.
model CallLog {
  id         Int      @id @default(autoincrement())
  /// Brokerage of the calling token.
  brokerCode String
  tool       String
  params     Json
  result     Json
  isError    Boolean
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
