{
  "name": "@demo/core-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && nest start --watch --preserveWatchOutput",
    "build": "prisma generate && nest build",
    "start": "prisma migrate deploy && node --env-file-if-exists=../../.env dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@demo/documents": "^0.0.0",
    "@demo/shared": "^0.0.0",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^5.81.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "prisma": "^7.10.1",
    "@demo/world-generator": "^0.0.0",
    "pg": "^8.16.3",
    "@types/pg": "^8.15.6"
  },
  "engines": {
    "node": ">=24"
  }
}
